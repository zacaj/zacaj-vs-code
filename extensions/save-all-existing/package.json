{
  "name": "save-all-existing",
  "displayName": "Save All Existing Files",
  "description": "Save every dirty file that already exists on disk, leaving untitled editors alone.",
  "version": "1.0.0",
  "publisher": "zacaj",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zacaj/zacaj-vs-code",
    "directory": "extensions/save-all-existing"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "zacaj.saveAllFiles",
        "title": "File: Save All Saved Files"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node ../../scripts/build-extension.mjs --production && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.84.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
