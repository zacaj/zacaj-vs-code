{
  "name": "zacaj-git",
  "displayName": "Git Extras",
  "description": "Extra Source Control context-menu actions: copy path, rename, untrack, add to .gitignore, and a toggle for untracked files.",
  "version": "0.0.1",
  "publisher": "zacaj",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zacaj/zacaj-vs-code",
    "directory": "extensions/git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "toggleUntracked.hide",
        "title": "Hide Untracked Files",
        "icon": "$(eye)"
      },
      {
        "command": "toggleUntracked.show",
        "title": "Show Untracked Files",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitignoreFolder.add",
        "title": "Add Folder to .gitignore"
      },
      {
        "command": "zacajGit.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "zacajGit.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "zacajGit.rename",
        "title": "Rename..."
      },
      {
        "command": "zacajGit.copyFolderPath",
        "title": "Copy Path"
      },
      {
        "command": "zacajGit.copyFolderRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "zacajGit.renameFolder",
        "title": "Rename..."
      },
      {
        "command": "zacajGit.untrack",
        "title": "Untrack (Keep File)"
      },
      {
        "command": "zacajGit.untrackIgnore",
        "title": "Untrack and Add to .gitignore"
      },
      {
        "command": "zacajGit.untrackFolder",
        "title": "Untrack Folder (Keep Files)"
      },
      {
        "command": "zacajGit.untrackIgnoreFolder",
        "title": "Untrack Folder and Add to .gitignore"
      },
      {
        "command": "zacajGit.gitignoreFile",
        "title": "Add File to .gitignore"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "toggleUntracked.hide",
          "when": "((view == workbench.scm && !scmProvider) || (scmProvider == git && scmRepositoryCount == 1)) && !untrackedHidden",
          "group": "navigation@100"
        },
        {
          "command": "toggleUntracked.show",
          "when": "((view == workbench.scm && !scmProvider) || (scmProvider == git && scmRepositoryCount == 1)) && untrackedHidden",
          "group": "navigation@100"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "gitignoreFolder.add",
          "when": "scmProvider == git",
          "group": "1_modification"
        },
        {
          "command": "zacajGit.copyFolderPath",
          "when": "scmProvider == git",
          "group": "6_copypath@1"
        },
        {
          "command": "zacajGit.copyFolderRelativePath",
          "when": "scmProvider == git",
          "group": "6_copypath@2"
        },
        {
          "command": "zacajGit.renameFolder",
          "when": "scmProvider == git",
          "group": "7_modification@1"
        },
        {
          "command": "zacajGit.untrackFolder",
          "when": "scmProvider == git && scmResourceGroup != untracked",
          "group": "1_modification@90"
        },
        {
          "command": "zacajGit.untrackIgnoreFolder",
          "when": "scmProvider == git && scmResourceGroup != untracked",
          "group": "1_modification@91"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "zacajGit.copyPath",
          "when": "scmProvider == git",
          "group": "6_copypath@1"
        },
        {
          "command": "zacajGit.copyRelativePath",
          "when": "scmProvider == git",
          "group": "6_copypath@2"
        },
        {
          "command": "zacajGit.rename",
          "when": "scmProvider == git && !listMultiSelection",
          "group": "7_modification@1"
        },
        {
          "command": "zacajGit.untrack",
          "when": "scmProvider == git && scmResourceGroup != untracked",
          "group": "1_modification@90"
        },
        {
          "command": "zacajGit.untrackIgnore",
          "when": "scmProvider == git && scmResourceGroup != untracked",
          "group": "1_modification@91"
        },
        {
          "command": "zacajGit.gitignoreFile",
          "when": "scmProvider == git",
          "group": "1_modification@89"
        }
      ],
      "commandPalette": [
        {
          "command": "zacajGit.copyPath",
          "when": "false"
        },
        {
          "command": "zacajGit.copyRelativePath",
          "when": "false"
        },
        {
          "command": "zacajGit.rename",
          "when": "false"
        },
        {
          "command": "zacajGit.copyFolderPath",
          "when": "false"
        },
        {
          "command": "zacajGit.copyFolderRelativePath",
          "when": "false"
        },
        {
          "command": "zacajGit.renameFolder",
          "when": "false"
        },
        {
          "command": "gitignoreFolder.add",
          "when": "false"
        },
        {
          "command": "zacajGit.untrack",
          "when": "false"
        },
        {
          "command": "zacajGit.untrackIgnore",
          "when": "false"
        },
        {
          "command": "zacajGit.untrackFolder",
          "when": "false"
        },
        {
          "command": "zacajGit.untrackIgnoreFolder",
          "when": "false"
        },
        {
          "command": "zacajGit.gitignoreFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node ../../scripts/build-extension.mjs --production && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.80.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
