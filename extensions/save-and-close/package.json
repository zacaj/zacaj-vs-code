{
  "name": "save-and-close-editor",
  "displayName": "Save and Close Editor",
  "description": "Adds a command to save and close editors in one go.",
  "version": "1.1.0",
  "publisher": "zacaj",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zacaj/zacaj-vs-code",
    "directory": "extensions/save-and-close"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "save-and-close-editor.saveAndCloseActiveEditor",
        "title": "File: Save and Close Editor"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node ../../scripts/build-extension.mjs --production && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.84.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
